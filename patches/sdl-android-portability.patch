diff --git a/project/jni/Android.mk b/project/jni/Android.mk
index 5bd2d5f..b65b5dc 100644
--- a/project/jni/Android.mk
+++ b/project/jni/Android.mk
@@ -1,3 +1,6 @@
+# Capture this directory before any include. NDK my-dir follows the last included makefile.
+JNI_PATH := $(call my-dir)
+
 # If SDL_Mixer should link to GPL-polluted libMAD (TODO: move this out of here)
 SDL_MIXER_USE_LIBMAD :=
 ifneq ($(strip $(filter mad, $(COMPILED_LIBRARIES))),)
@@ -30,4 +33,8 @@ else
 NDK_PATH := $(shell dirname $(shell which ndk-build))
 endif
 
-include $(call all-subdir-makefiles)
+# SDL2_mixer pulls optional codec trees (libgme and others) that OpenTTD does not ship or link.
+# NDK r29 parses every top-level Android.mk, so skip that unused module.
+include $(filter-out $(JNI_PATH)/sdl2_mixer/Android.mk,$(wildcard $(JNI_PATH)/*/Android.mk))
+# libogg sources live in the SDL2_mixer tree. OpenTTD's module list still builds ogg.
+include $(JNI_PATH)/sdl2_mixer/external/ogg/Android.mk
