+static void StartGeneratingLandscape(GenerateLandscapeWindowMode mode);
+
+/**
+ * Towns OpenTTD will try to place. "Normal" on a 256 map is a few dozen.
+ * The same setting on a 4096 map is about 6,144 towns.
+ */
+static uint EstimateInitialTowns()
+{
+	static const uint base_towns[4] = {5, 11, 23, 46};
+	uint difficulty = _settings_newgame.difficulty.number_towns;
+	if (difficulty == CUSTOM_TOWN_NUMBER_DIFFICULTY) return _settings_newgame.game_creation.custom_town_number;
+
+	/* Generation adds Random() & 7. Four is the middle of that range. */
+	uint base = base_towns[difficulty] + 4;
+	uint shift = _settings_newgame.game_creation.map_x + _settings_newgame.game_creation.map_y - 12;
+	return CeilDiv(base << shift, 16u);
+}
+
+static void ConfirmManyTownsCallback(Window *, bool confirmed)
+{
+	if (confirmed) StartGeneratingLandscape(GLWM_GENERATE);
+}
+
+void StartIndustryEmpireQuickStart()
+{
+	_settings_newgame.game_creation.landscape = LT_TEMPERATE;
+	_settings_newgame.game_creation.map_x = 8;
+	_settings_newgame.game_creation.map_y = 8;
+	_settings_newgame.difficulty.number_towns = 1;
+	_settings_newgame.difficulty.industry_density = ID_NORMAL;
+	_settings_newgame.difficulty.terrain_type = 2;
+	_settings_newgame.difficulty.max_no_competitors = 0;
+	_settings_newgame.difficulty.vehicle_breakdowns = 0;
+	/* High variety and medium rivers, not the maximum of either slider.
+	 * Hilly (not alpine) terrain, rough (not very rough) noise, and the
+	 * improved tree placer so forests clump instead of carpeting the map. */
+	_settings_newgame.game_creation.variety = 4;
+	_settings_newgame.game_creation.amount_of_rivers = 2;
+	_settings_newgame.game_creation.tree_placer = 2;
+	_settings_newgame.game_creation.tgen_smoothness = TGEN_SMOOTHNESS_ROUGH;
+	/* 0 = trees grow in place but do not spread across open ground. */
+	_settings_newgame.construction.extra_tree_placement = 0;
+	_settings_newgame.game_creation.starting_year = CalendarTime::DEF_START_YEAR;
+
+	Game::Rescan();
+	GameConfig::GetConfig(GameConfig::SSS_FORCE_NEWGAME)->Change("First Route");
+
+	std::string scenario = FioFindFullPath(SCENARIO_DIR, "Coastal Valley.scn");
+	if (!scenario.empty()) {
+		CloseAllNonVitalWindows();
+		ClearErrorMessages();
+		_file_to_saveload.name = std::move(scenario);
+		_file_to_saveload.SetMode(SLO_LOAD, FT_SCENARIO, DFT_GAME_FILE);
+		_switch_mode = SM_LOAD_GAME;
+		return;
+	}
+	StartNewGameWithoutGUI(GENERATE_NEW_SEED);
+}
